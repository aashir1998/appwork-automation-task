{
  "name": "appwork-automation-task",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:smoke": "cypress run --expose grepTags=@Smoke",
    "test:regression": "cypress run --expose grepTags=@Regression",
    "report:merge": "mochawesome-merge cypress/reports/mocha/*.json > cypress/reports/report.json",
    "report:generate": "marge cypress/reports/report.json -o cypress/reports/html --inline",
    "report": "npm run report:merge && npm run report:generate",
    "pretest": "rm -rf cypress/reports",
    "test": "sh scripts/run-tests.sh",
    "lint": "eslint cypress",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "cypress": "^16.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-plugin-cypress": "^7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "prettier": "^3.9.7"
  },
  "lint-staged": {
    "cypress/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "{eslint.config.js,cypress.config.js}": [
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
